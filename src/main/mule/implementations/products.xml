<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
	<flow name="getProducts" doc:id="d59f6be8-b902-4e0e-9841-4d5bc87b307a" >
		<flow-ref doc:name="get-all-products" doc:id="b718f1a1-b3a8-423e-9580-8063416b1ac4" name="getAllProducts"/>
		<choice doc:name="Choice" doc:id="a4fed569-09ab-4136-a75b-75f108d53a2e" >
			<when expression="#[vars.category != null]">
				<ee:transform doc:name="Transform Message" doc:id="61f1633d-c03e-4130-896f-50eed437cd13" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload filter (product) -> product.category == vars.category]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<set-payload value="#[payload]" doc:name="All products" doc:id="c5732d51-56d4-48cf-8108-d066fc501f60" />
			</otherwise>
		</choice>
	</flow>
	<flow name="PostProduct" doc:id="240efbe9-faea-41fa-b9dd-66181726ea6c" >
		<logger level="INFO" doc:name="Logger" doc:id="54b7e6ed-da94-43fe-9b16-6b3de4e5f456" message="Incoming body: #[payload]"/>
		<set-variable value="#[payload]" doc:name="[newProduct]" doc:id="0a83c10a-b413-49d8-815d-7148a66b69d5" variableName="newProduct"/>
		<flow-ref doc:name="get-all-products" doc:id="45406bbc-7cad-4de5-9876-dadfdf9577a2" name="getAllProducts"/>
		<validation:is-false doc:name="Check product does not exists" doc:id="d0b44d6a-879a-43e1-8d21-822f6f8e69c3" expression="#[modules::Products::idExists(payload, vars.newProduct.id)]" message="Product exists">
			<error-mapping sourceType="VALIDATION:INVALID_BOOLEAN" targetType="PRODUCTS:NOT_ACCEPTABLE" />
		</validation:is-false>
		<ee:transform doc:name="Append" doc:id="15e5ea7c-2663-4af2-b2b7-f1be4968ac4f">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
import * from modules::Products

---

addProduct(payload, vars.newProduct)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Write-to-sftp" doc:id="fe087984-82d9-49c4-aec5-a4b695e206f7" name="Write-to-sftp" />
		<set-payload value="#[vars.newProduct]" doc:name="Set Payload" doc:id="4d8a9291-d3c7-40ab-a6bc-e81a389de7fb" />
	</flow>
	<flow name="PostNewStock" doc:id="480d5ff5-5741-456b-869c-180a2a66c9d1" >
		<flow-ref doc:name="get-all-products" doc:id="29739abc-6538-4f9b-8237-99d1da4fb9c8" name="getAllProducts" />
		<flow-ref doc:name="Check product exists" doc:id="7f19c8d5-f861-4592-9e21-5b96adafd0b2" name="Check-product-exists"/>
		<ee:transform doc:name="Increment Stock" doc:id="2b89bc6d-45d8-418f-aa46-d13c8e156c75" >
			<ee:message >
				<ee:set-payload ><![CDATA[output application/java
import * from modules::Products

---
incrementStock(payload, vars.id)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Write-to-sftp" doc:id="8d16caed-97a9-4e94-b7ca-425d35688cb7" name="Write-to-sftp"/>
	</flow>
	<flow name="delete-a-product" doc:id="b668e160-afed-4f4d-8d3d-d68f61fa97dc" >
		<flow-ref doc:name="get-all-products" doc:id="82b05653-d5a1-447a-8212-f970c64bf315" name="getAllProducts"/>
		<flow-ref doc:name="Check product exists" doc:id="80e18db9-f8d7-4616-a235-e0010c70ddee" name="Check-product-exists"/>
		<ee:transform doc:name="Delete" doc:id="ef973c7e-f945-4610-98e0-87efbf19cfd8" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
import * from modules::Products

---
if(vars.qty ~= 0)
   deleteProduct(payload, vars.id)
else
   removeStock(payload, vars.id, vars.qty)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Write-to-sftp" doc:id="91834cb2-5600-4b66-a159-f56e5725db69" name="Write-to-sftp" />
	</flow>
	<sub-flow name="Check-product-exists" doc:id="4ea1b050-ab47-43b1-8874-877cdc3f5c45" >
		<validation:is-true doc:name="Check product exists" doc:id="d2bb572b-5607-4801-b56d-0abb1f97dea2" expression="#[modules::Products::idExists(payload, vars.id)]" message="Product not found">
			<error-mapping sourceType="VALIDATION:INVALID_BOOLEAN" targetType="PRODUCTS:NOT_FOUND" />
		</validation:is-true>
	</sub-flow>
	<sub-flow name="Write-to-sftp" doc:id="50f51f16-c4af-47d7-9ad9-850857cccaf2" >
		<ee:transform doc:name="To CSV" doc:id="24ce59d1-3189-4105-bc42-ebebd5334725">
			<ee:message>
				<ee:set-payload><![CDATA[output application/csv header=true
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<sftp:write doc:name="Write" doc:id="3ed44f4a-9b23-4dcc-9e79-5e0e4a711299" config-ref="SFTP_Config" path="${sftp.filename-product}" />
	</sub-flow>
	<flow name="getAllProducts" doc:id="905db680-849b-442d-a1fa-3adb615a5f65" >
		<sftp:read doc:name="Read" doc:id="69c6f7bb-399b-457e-b2c7-bfebe74b42cb" config-ref="SFTP_Config" path="${sftp.filename-product}"/>
		<logger level="INFO" doc:name="Logger" doc:id="1d11f452-b72f-4dbb-b74d-9517b4626edc" message="#[payload]"/>
		<ee:transform doc:name="Transform Message" doc:id="ebcbd3db-2af5-4c5f-838f-914b6dded587" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import * from modules::Products

---
toTypedProducts(payload as Array)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
